# Copy to .env and fill in real values. Never commit .env — it is gitignored.

# Remote inference is OFF until the operator verifies the provider routes.
# This is an operator switch, not an automatic verification of billing status.
ENABLE_PROVIDER_CALLS=false
# sample keeps live submissions closed. Set invited before trying public.
DEMO_LIVE_MODE=sample
# Generate distinct secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JOB_TOKEN_SECRET=
# Share privately with invited visitors. The server checks this before upload parsing.
DEMO_INVITE_CODE=
# Separate secret for private evaluation of the built-in synthetic fixture.
OWNER_EVALUATION_TOKEN=
# Paid Meta is restricted to explicitly authorized owner runs.
ENABLE_PAID_META=false
# With ENABLE_PAID_META=true, also let public jobs use Meta as the last fallback
# after every free route fails. Capped at one Meta call and $0.01 per job, $0.05 per day.
ENABLE_PUBLIC_PAID_FALLBACK=false
# NVIDIA API catalog is a trial; by default only owner runs may use it.
ENABLE_NVIDIA_PUBLIC=false
# Stable private random secret, at least 32 characters; required when enabled.
# Generate locally: python -c "import secrets; print(secrets.token_hex(32))"
RATE_LIMIT_SECRET=

# Optional paths remain OFF: Sarvam signup credits are finite; hosted YouTube
# downloads are unreliable. Never enable automatic paid fallback or top-ups.
ENABLE_SARVAM=false
ENABLE_YOUTUBE=false

# Provider profiles are empty until the operator verifies model access, free
# limits and data-use terms. See docs/HYBRID_IMPLEMENTATION.md for the schema.
LLM_ROUTES_JSON=[]
# Optional preferred route aliases per task (title, summary, extract, chat).
# Unlisted routes stay as fallbacks in default order; paid Meta is always last.
# Example: {"title":["nvidia-nemotron"],"summary":["groq-economy"],"chat":["gemini-flash"]}
LLM_TASK_ROUTES_JSON={}
# Ordered transcription fallback chain, tried per 5-minute chunk: groq (any Whisper model),
# gemini (Flash-Lite, approximate timestamps), sarvam (Hinglish only: saaras:v3, translated to English,
# with Groq whisper-large-v3 translation as its fallback; needs ENABLE_SARVAM=true), and meta
# (muse-voice-transcribe-1.0, $0.18/audio hour, verified_free=false, always last, needs
# ENABLE_PAID_META and ENABLE_PUBLIC_PAID_FALLBACK).
STT_PROFILES_JSON=[]
# In order: openrouter-nemotron, cloudflare-qwen, gemini-embeddings, nvidia-nemotron.
# Omit unverified routes. Each entry has id, verified_free, rpm, tpm and rpd.
# Both Nemotron trial routes are for internal evaluation and disabled on Render.
EMBEDDING_ROUTES_JSON=[]
# To use the legacy Gemini profile, remove EMBEDDING_ROUTES_JSON entirely.
# An explicit [] disables embeddings.
GEMINI_API_KEY=
ENABLE_GEMINI_EMBEDDINGS=false
GEMINI_EMBEDDINGS_VERIFIED_FREE=false
GEMINI_EMBEDDINGS_RPM=
GEMINI_EMBEDDINGS_TPM=
GEMINI_EMBEDDINGS_RPD=

# Groq key for English transcription and optional verified generation routes.
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI_TOKEN=
META_API_KEY=

# ── Speech-to-text: Hinglish (Sarvam) ─────────────────────────────────────────
SARVAM_API_KEY=

# ── Persistent storage: Neon serverless Postgres (pgvector extension) ─────────
# Neon gives you a connection string like:
#   postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=

# ── CORS: exact React frontend origins, no trailing slash ─────────────────────
# Comma-separated; defaults to http://localhost:5173 if unset.
FRONTEND_ORIGIN=

# ── Demo resource limits (MiB / seconds) ──────────────────────────────────────
MAX_UPLOAD_MB=25
MAX_DOWNLOAD_MB=25
MAX_MEDIA_SECONDS=600

# UTC fixed-window quotas persist in Postgres, independent of job deletion.
JOBS_PER_IP_DAY=1
JOBS_GLOBAL_DAY=5
CHATS_PER_IP_MINUTE=2
CHATS_PER_IP_DAY=15
CHATS_PER_JOB_DAY=3
CHATS_GLOBAL_DAY=15
# One processing job and one chat request may run globally at a time.
# IP identity uses request.client, not arbitrary X-Forwarded-For headers.
# Configure trusted reverse proxies only after checking your hosting path.

# ── Admin token for POST /admin/cleanup (purge old jobs + their vectors) ───────
# Send it as the X-Admin-Token header. Leave blank to disable the endpoint
# entirely (it returns 503 until a token is set). Use a long random string.
ADMIN_TOKEN=
