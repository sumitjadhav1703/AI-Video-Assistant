@@ -0,0 +1,190 @@
+"""Paired A/B comparison of two evaluated pipeline versions, with the gate pre-registered in the v2 plan.
+
+Run: evaluation/.venv/bin/python -m evaluation.runners.compare v1-pinned v2
+Writes evaluation/reports/comparison_<a>_vs_<b>.md and .json. Only cases present in BOTH runs are compared.
+"""
+import json
+import statistics
+import sys
+from pathlib import Path
+
+from evaluation import config
+from evaluation.metrics import deterministic
+from evaluation.runners import experiments
+from evaluation.runners.report import percentile
+
+REPORTS = config.EVAL_DIR / 'reports'
+JUDGE_METRICS = ('Faithfulness', 'Answer Relevancy', 'Contextual Precision', 'Contextual Recall', 'Contextual Relevancy')
+
+
+def load_run(tag):
+    raw = REPORTS / tag / 'raw'
+    answers = {p.stem: json.loads(p.read_text()) for p in sorted((raw / 'answers').glob('*.json'))}
+    judge = {}
+    path = raw / 'judge' / 'generation.json'
+    if path.exists():
+        for row in json.loads(path.read_text()):
+            judge[row['name'].split(':')[0]] = {m['name']: m['score'] for m in row['metrics'] if not m['error'] and m['score'] is not None}
+    repeat = {}
+    path = raw / 'judge_repeat' / 'generation.json'
+    if path.exists():
+        for row in json.loads(path.read_text()):
+            repeat[row['name'].split(':')[0]] = {m['name']: m['score'] for m in row['metrics'] if not m['error'] and m['score'] is not None}
+    return {'answers': answers, 'judge': judge, 'repeat': repeat, 'raw': raw}
+
+
+def behaviour(case):
+    if case['result'] is None:
+        return {'expected': case['golden']['expected_behavior'], 'outcome': 'error', 'correct': False}
+    return deterministic.check_behavior(case['result'], case['golden'])
+
+
+def rejected_outputs(case):
+    ok = [c for c in case['calls'] if c.get('ok')]
+    return len(ok) - (1 if case['result'] is not None and ok else 0)
+
+
+def judge_noise(run):
+    """Mean absolute score difference between two judge passes over the same answers, per metric."""
+    out = {}
+    for metric in JUDGE_METRICS:
+        diffs = [abs(run['judge'][i][metric] - run['repeat'][i][metric]) for i in run['repeat']
+                 if metric in run['repeat'][i] and metric in run['judge'].get(i, {})]
+        out[metric] = {'mean_abs_diff': statistics.fmean(diffs) if diffs else None, 'n': len(diffs)}
+    return out
+
+
+def compare(tag_a, tag_b):
+    a, b = load_run(tag_a), load_run(tag_b)
+    ids = sorted(set(a['answers']) & set(b['answers']))
+    rows = {}
+    beh = {t: [behaviour(r['answers'][i]) for i in ids] for t, r in ((tag_a, a), (tag_b, b))}
+    rows['behaviour_accuracy'] = {t: sum(x['correct'] for x in v) / len(v) for t, v in beh.items()}
+    rows['request_errors_503'] = {t: sum(r['answers'][i]['result'] is None for i in ids) for t, r in ((tag_a, a), (tag_b, b))}
+    rows['rejected_model_outputs'] = {t: sum(rejected_outputs(r['answers'][i]) for i in ids) for t, r in ((tag_a, a), (tag_b, b))}
+    rows['provider_attempts'] = {t: sum(len(r['answers'][i]['calls']) for i in ids) for t, r in ((tag_a, a), (tag_b, b))}
+    rows['abstention'] = {t: deterministic.abstention_metrics(v) for t, v in beh.items()}
+    cites = {}
+    for t, r in ((tag_a, a), (tag_b, b)):
+        checks = [c for i in ids if r['answers'][i]['result'] for c in deterministic.check_citations(
+            r['answers'][i]['result'], {x['chunk_id']: x for x in r['answers'][i]['contexts']['final']})['details']]
+        cites[t] = {'n': len(checks), 'valid_rate': sum(c['valid'] for c in checks) / len(checks) if checks else None}
+    rows['citations'] = cites
+
+    judged = sorted(set(a['judge']) & set(b['judge']))
+    deepeval = {}
+    for metric in JUDGE_METRICS:
+        pairs = [(a['judge'][i][metric], b['judge'][i][metric]) for i in judged if metric in a['judge'][i] and metric in b['judge'][i]]
+        if pairs:
+            deepeval[metric] = {tag_a: statistics.fmean(p[0] for p in pairs), tag_b: statistics.fmean(p[1] for p in pairs),
+                                'n': len(pairs), 'bootstrap': experiments.paired_bootstrap([p[0] for p in pairs], [p[1] for p in pairs])}
+    # Questions answered by only one version cannot be judged pairwise; report them separately.
+    only = {tag_a: sorted(set(a['judge']) - set(b['judge'])), tag_b: sorted(set(b['judge']) - set(a['judge']))}
+
+    cov = {}
+    for t, r in ((tag_a, a), (tag_b, b)):
+        saved = config.RAW_DIR
+        config.RAW_DIR = r['raw']  # experiments.chunk_texts reads the run's own chunk file
+        try:
+            _, per_case = experiments.ir_table([r['answers'][i] for i in ids], variants={'hybrid_rerank': 'reranked_ranking'})
+        finally:
+            config.RAW_DIR = saved
+        cov[t] = per_case['hybrid_rerank']
+    shared = [i for i in ids if cov[tag_a].get(i) and cov[tag_b].get(i)]
+    qa = [cov[tag_a][i]['quote_coverage'] for i in shared]
+    qb = [cov[tag_b][i]['quote_coverage'] for i in shared]
+    retrieval = {'quote_coverage@4': {tag_a: statistics.fmean(qa) if qa else None, tag_b: statistics.fmean(qb) if qb else None,
+                                      'n': len(shared), 'bootstrap': experiments.paired_bootstrap(qa, qb)}}
+
+    # Paired: only questions both versions answered, so a version is not rewarded for failing the hard ones.
+    both = [i for i in ids if all(r['answers'][i]['result'] is not None and not r['answers'][i].get('cold')
+                                  and not r['answers'][i].get('replayed') for r in (a, b))]
+    latency = {}
+    for t, r in ((tag_a, a), (tag_b, b)):
+        e2e = [r['answers'][i]['e2e_ms'] for i in both]
+        gen = [c['elapsed_ms'] for i in both for c in r['answers'][i]['calls'] if c.get('ok')]
+        latency[t] = {'n': len(e2e), 'p50': percentile(e2e, .5), 'p95': percentile(e2e, .95),
+                      'generation_p50': percentile(gen, .5), 'generation_p95': percentile(gen, .95),
+                      'answer_chars_p50': percentile([len(r['answers'][i]['result']['answer']) for i in both], .5)}
+
+    noise = judge_noise(b) if b['repeat'] else None
+    gate = decide(rows, deepeval, retrieval, latency, noise, tag_a, tag_b)
+    return {'cases_compared': len(ids), 'cases_judged_in_both': len(judged), 'judged_in_only_one': only,
+            'deterministic': rows, 'deepeval': deepeval, 'retrieval': retrieval, 'latency': latency,
+            'judge_noise': noise, 'gate': gate}
+
+
+def decide(rows, deepeval, retrieval, latency, noise, a, b):
+    """The 'better' gate written before the run (see evaluation/IMPROVEMENTS_V2.md)."""
+    tolerance = {m: max(0.05, (noise or {}).get(m, {}).get('mean_abs_diff') or 0) for m in JUDGE_METRICS}
+    must = {
+        'faithfulness_not_worse': 'Faithfulness' in deepeval and deepeval['Faithfulness'][b] >= deepeval['Faithfulness'][a] - tolerance['Faithfulness'],
+        'answer_relevancy_not_worse': 'Answer Relevancy' in deepeval and deepeval['Answer Relevancy'][b] >= deepeval['Answer Relevancy'][a] - tolerance['Answer Relevancy'],
+        'citation_validity_100': rows['citations'][b]['valid_rate'] == 1.0,
+        'abstention_f1_not_worse': (rows['abstention'][b]['abstention_f1'] or 0) >= (rows['abstention'][a]['abstention_f1'] or 0),
+        'quote_coverage_not_worse': retrieval['quote_coverage@4'][b] >= retrieval['quote_coverage@4'][a] - 0.05,
+        'latency_p95_within_25pct': latency[b]['p95'] <= 1.25 * latency[a]['p95'],
+    }
+    primary = {
+        'fewer_rejected_outputs': rows['rejected_model_outputs'][b] < rows['rejected_model_outputs'][a],
+        'fewer_503s': rows['request_errors_503'][b] < rows['request_errors_503'][a],
+        'higher_behaviour_accuracy': rows['behaviour_accuracy'][b] > rows['behaviour_accuracy'][a],
+        'contextual_precision_or_recall_beyond_noise': any(
+            m in deepeval and deepeval[m][b] - deepeval[m][a] > tolerance[m] for m in ('Contextual Precision', 'Contextual Recall')),
+    }
+    return {'must_hold': must, 'primary_improvements': primary, 'tolerances': tolerance,
+            'better': all(must.values()) and any(primary.values())}
+
+
+def _f(v, d=3):
+    return '—' if v is None else (f'{v:.{d}f}' if isinstance(v, float) else str(v))
+
+
+def to_markdown(result, a, b):
+    d = result['deterministic']
+    lines = [f'# Comparison: {a} vs {b}', '',
+             f'Paired over {result["cases_compared"]} goldens answered in both runs; DeepEval over '
+             f'{result["cases_judged_in_both"]} judged in both. Same dataset, same pinned generator, same embedding model.', '',
+             '## Deterministic (whole paired set)', '', f'| Metric | {a} | {b} |', '|---|---|---|']
+    for key in ('behaviour_accuracy', 'request_errors_503', 'rejected_model_outputs', 'provider_attempts'):
+        lines.append(f'| {key} | {_f(d[key][a])} | {_f(d[key][b])} |')
+    lines.append(f'| citation validity | {_f(d["citations"][a]["valid_rate"])} ({d["citations"][a]["n"]}) | '
+                 f'{_f(d["citations"][b]["valid_rate"])} ({d["citations"][b]["n"]}) |')
+    lines.append(f'| abstention F1 | {_f(d["abstention"][a]["abstention_f1"])} | {_f(d["abstention"][b]["abstention_f1"])} |')
+    lines += ['', '## DeepEval (paired, judge meta/muse-spark-1.3)', '', f'| Metric | {a} | {b} | Δ (95% CI) | n |', '|---|---|---|---|---|']
+    for m, v in result['deepeval'].items():
+        bs = v['bootstrap']
+        lines.append(f'| {m} | {_f(v[a])} | {_f(v[b])} | {bs["mean_diff"]:+.3f} [{bs["ci95"][0]:+.3f}, {bs["ci95"][1]:+.3f}] | {v["n"]} |')
+    only = result['judged_in_only_one']
+    lines += ['', f'Judged in only one run (the other produced no answer): {a}: {only[a] or "none"}; {b}: {only[b] or "none"}.']
+    r = result['retrieval']['quote_coverage@4']
+    lines += ['', '## Retrieval', '', f'- quote coverage@4 (production hybrid + rerank): {a} {_f(r[a])} vs {b} {_f(r[b])}, '
+              f'Δ {r["bootstrap"]["mean_diff"]:+.3f} [{r["bootstrap"]["ci95"][0]:+.3f}, {r["bootstrap"]["ci95"][1]:+.3f}], n={r["n"]}']
+    lat = result['latency']
+    lines += ['', '## Latency (paired: warm questions both versions answered)', '',
+              *[f'- {t}: e2e p50 {_f(lat[t]["p50"], 0)} ms, p95 {_f(lat[t]["p95"], 0)} ms; generation p50 '
+                f'{_f(lat[t]["generation_p50"], 0)} ms, p95 {_f(lat[t]["generation_p95"], 0)} ms; answer length p50 '
+                f'{_f(lat[t]["answer_chars_p50"], 0)} chars (n={lat[t]["n"]} questions answered by both)' for t in (a, b)]]
+    if result['judge_noise']:
+        lines += ['', f'## Judge noise ({b} judged twice)', '']
+        lines += [f'- {m}: mean |Δ| {_f(v["mean_abs_diff"])} over {v["n"]} cases' for m, v in result['judge_noise'].items()]
+    g = result['gate']
+    lines += ['', '## Gate (pre-registered)', '', '| Must hold | Result |', '|---|---|']
+    lines += [f'| {k} | {"pass" if v else "FAIL"} |' for k, v in g['must_hold'].items()]
+    lines += ['', '| Primary improvement (at least one) | Result |', '|---|---|']
+    lines += [f'| {k} | {"yes" if v else "no"} |' for k, v in g['primary_improvements'].items()]
+    lines += ['', f'**Verdict: {b} is {"BETTER" if g["better"] else "NOT shown to be better"} than {a}.**', '']
+    return '\n'.join(lines)
+
+
+def main(argv=None):
+    a, b = (argv or sys.argv[1:])[:2]
+    result = compare(a, b)
+    Path(REPORTS / f'comparison_{a}_vs_{b}.json').write_text(json.dumps(result, indent=2, default=str))
+    Path(REPORTS / f'comparison_{a}_vs_{b}.md').write_text(to_markdown(result, a, b))
+    print(to_markdown(result, a, b))
+    return 0 if result['gate']['better'] else 1
+
+
+if __name__ == '__main__':
+    sys.exit(main())
