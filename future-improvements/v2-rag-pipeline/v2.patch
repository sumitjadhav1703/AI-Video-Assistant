+TARGET_CHARS = 500
+OVERLAP_MAX_CHARS = 250
+_SENTENCE = re.compile(r'[^.!?]+(?:[.!?]+|$)\s*')
+
+
+def _units(text):
+    """Sentence spans; a sentence longer than the target is cut at word boundaries (hard cut if it has none)."""
+    units = []
+    for match in _SENTENCE.finditer(text):
+        start, end = match.start(), match.end()
+        while end - start > TARGET_CHARS:
+            cut = text.rfind(' ', start + 1, start + TARGET_CHARS + 1)
+            cut = cut if cut > start else start + TARGET_CHARS
+            units.append((start, cut))
+            start = cut
+        units.append((start, end))
+    return units
+
+
+def _spans(text):
+    """Pack whole sentences up to ~500 chars, repeating one short sentence as overlap; never cut mid-word."""
+    units = _units(text)
+    spans, i = [], 0
+    while i < len(units):
+        j = i + 1
+        while j < len(units) and units[j][1] - units[i][0] <= TARGET_CHARS:
+            j += 1
+        if units[-1][1] - units[i][0] <= TARGET_CHARS + 50:
+            j = len(units)  # fold a short tail into this chunk instead of emitting a near-duplicate
+        spans.append((units[i][0], units[j - 1][1]))
+        if j == len(units):
+            break
+        last = units[j - 1]
+        i = j - 1 if j - 1 > i and last[1] - last[0] <= OVERLAP_MAX_CHARS else j
+    return spans
+
